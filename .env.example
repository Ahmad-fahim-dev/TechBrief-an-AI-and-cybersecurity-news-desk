APP_NAME=TechBref
DATABASE_URL=sqlite:///./techbref.db
TIMEZONE=Asia/Karachi
SCHEDULED_TIME=09:00
SCHEDULE_ENABLED=true
ARTICLES_PER_CATEGORY=7
REQUEST_TIMEOUT_SECONDS=12
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=
# Optional JSON array; when omitted, the built-in official and established RSS feeds are used.
# Example: [{"category":"ai","name":"Example Research","url":"https://example.org/feed.xml"}]
RSS_FEEDS_JSON=
# Required to unlock the admin-only AGENT GOVERNANCE dashboard and APIs.
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_TOKEN=
ADMIN_USER_ID=admin
